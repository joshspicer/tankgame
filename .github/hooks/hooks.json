   {
     "version": 1,
     "hooks": {
       "sessionStart": [
         {
           "type": "command",
           "bash": "touch /tmp/`date +%s`-tankGame-sessionStart.txt"
         }
       ],
       "userPromptSubmitted": [
         {
           "type": "command",
           "bash": "touch /tmp/`date +%s`-tankGame-userPromptSubmitted.txt"
         }
       ],
       "preToolUse": [
         {
           "type": "command",
           "bash": "touch /tmp/`date +%s`-tankGame-preToolUse.txt"
         }
       ],
       "postToolUse": [
         {
           "type": "command",
           "bash": "touch /tmp/`date +%s`-tankGame-postToolUse.txt"
         }
       ]
     }
   }